generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String           @id @default(cuid())
  name                 String?
  email                String?          @unique
  emailVerified        DateTime?
  password             String?          
  image                String?
  sessions             Session[]
  workspaces           Workspace[]
  workspaceMemberships TeamMember[]
  currentWorkspaceId   String?
  createdAt            DateTime         @default(now())
  accounts             Account[]
  oneTimeProducts      OneTimeProduct[] @relation("OneTimeProductToUser")

  CustomField CustomField[]
}

model Workspace {
  id                   String           @id @default(cuid())
  ownerId              String           // Relation to User (owner)
  owner                User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customerId           String?          @unique
  stripeAccountId      String?
  wompiAccountId       Json?
  subscriptionId       String?
  siteName             String?
  aboutUs              String?
  logo                 String?
  favicon              String?
  country              String?
  currency             String?          @default("🇺🇸 USD")
  defaultPaymentMethod String?          @default("cash")
  subdomain            String?          @unique
  customDomain         String?          @unique
  categories           Category[]
  extras               Extras[]
  spots                Spot[]
  teamMembers          TeamMember[]
  customFields         CustomField[]
}
model TeamMember {
  id           String           @id @default(cuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id])
  workspaceId  String
  workspace    Workspace        @relation(fields: [workspaceId], references: [id])
  role         String
  status       TeamMemberStatus @default(Pending)
  invitation   Invitation?      @relation("InvitationToTeamMember") 
  joinedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime?        @updatedAt
}

model Invitation {
  id           String       @id @default(cuid())
  email        String
  token        String       @unique
  createdAt    DateTime     @default(now())
  teamMemberId String       @unique
  teamMember   TeamMember  @relation("InvitationToTeamMember", fields: [teamMemberId], references: [id], onDelete: Cascade)
}

model Spot {
  id                   String       @id @default(cuid())
  workspaceId          String
  workspace            Workspace    @relation(fields: [workspaceId], references: [id])
  name                 String
  description          String
  status               SpotStatus
  path                 String       @default("")
  units                Int?
  maxGuest             Int?
  duration             Int?
  durationType         String?
  amenities            String[]
  allowAdditionalGuest Boolean      @default(false)
  additionalGuestPrice Float?
  workingHours         Json         @default("[]")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime?    @default(now())
  bookings             Booking[]
  images               SpotImages[]
  extras               Extras[]     @relation("ExtrasToSpot")
}

model SpotImages {
  id        String   @id @default(cuid())
  url       String
  spotId    String
  createdAt DateTime @default(now())
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
}

model ExtrasImages {
  id        String   @id @default(cuid())
  url       String
  extraId   String
  createdAt DateTime @default(now())
  Extras    Extras   @relation(fields: [extraId], references: [id], onDelete: Cascade)
}

model Booking {
  id            String          @id @default(cuid())
  subtotal      Float
  extras        Float?
  tax           Float?
  totalPrice    Float
  startDate     DateTime?
  endDate       DateTime?
  status        BookingStatus
  note          String    @default("")
  customerId    String?  
  spotId        String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @default(now())
  deletedAt     DateTime?
  customer      Customer?       @relation(fields: [customerId], references: [id])
  spot          Spot            @relation(fields: [spotId], references: [id])
  bookingExtras BookingExtras[]
  transactions  Transaction[]
  customFields BookingCustomField[]
}

model CustomField {
  id            String          @id @default(cuid())
  workspaceId   String
  workspace     Workspace       @relation(fields: [workspaceId], references: [id])
  fieldName     String   // Name of the field
  fieldType     CustomFieldType   // Type of field (e.g., String, Integer, Select)
  placeholder   String  @default("")// Placeholder for the field
  isRequired    Boolean  @default(false) // Whether it's required
  visibility    Boolean  @default(false) // Whether it's visible on the booking page
  options       String?  // Options for select-type fields (stored as a JSON array)
  createdById   String   // User who created the field
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @default(now())
  BookingCustomField BookingCustomField[]
}

model BookingCustomField {
  id            String          @id @default(cuid())
  bookingId     String      // Reference to the booking
  customFieldId String      // Reference to the custom field
  value         Json     // Value of the custom field (stored as JSON to handle any type)
  CustomField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  Booking       Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}


model Transaction {
  id            String            @id @default(cuid())
  amount        Float
  paymentDate   DateTime
  paymentMethod String            @default("Cash")
  description   String
  status        TransactionStatus @default(Pending)
  allowEdit     Boolean           @default(true)
  bookingId     String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime?         @updatedAt
  deletedAt     DateTime?
  booking       Booking           @relation(fields: [bookingId], references: [id])
}

model Extras {
  id            String          @id @default(cuid())
  workspaceId   String
  workspace     Workspace       @relation(fields: [workspaceId], references: [id])
  name          String
  description   String
  price         Float
  status        ExtrasStatus
  categoryId    String?
  subCategoryId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @default(now())
  bookingExtras BookingExtras[]
  category      Category?       @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory?    @relation(fields: [subCategoryId], references: [id])
  images        ExtrasImages[]
  spots         Spot[]          @relation("ExtrasToSpot")
}

model Customer {
  id       String    @id @default(cuid())
  name     String
  email    String
  phone    String
  dni      String
  address  String?
  note     String    @default("")
  bookings Booking[]
}

model BookingExtras {
  id        String    @id @default(cuid())
  bookingId String
  extraId   String
  quantity  Int       @default(1)
  price     Float
  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now())
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  extra     Extras    @relation(fields: [extraId], references: [id])
}

model Category {
  id            String        @id @default(cuid())
  workspaceId   String
  owner         Workspace     @relation(fields: [workspaceId], references: [id])
  name          String
  createdAt     DateTime      @default(now())
  extras        Extras[]
  subCategories SubCategory[]
}

model SubCategory {
  id         String   @id @default(cuid())
  name       String
  createdAt  DateTime @default(now())
  categoryId String
  extras     Extras[]
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model OneTimeProduct {
  id              String @id @default(cuid())
  stripeProductId String @unique
  name            String
  users           User[] @relation("OneTimeProductToUser")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum BookingStatus {
  In_progress
  Confirmed
  Cancelled
  Waiting_for_payment
}

enum SpotStatus {
  Private
  Public
  Disabled
}

enum TransactionStatus {
  Approved
  Pending
  Declined
  Paid
  Cancelled
}

enum ExtrasStatus {
  Private
  Public
  Disabled
}

enum TeamMemberStatus {
  Pending
  Active
  Inactive
}
enum CustomFieldType {
  String
  Number
  Dropdown
  Date
  Time
  File
}