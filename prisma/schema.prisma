// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? // @db.Text
  access_token      String? // @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String           @id @default(cuid())
  name                 String?
  email                String?          @unique
  emailVerified        DateTime?
  image                String?
  accounts             Account[]
  sessions             Session[]
  createdAt            DateTime         @default(now())
  customerId           String?          @unique
  stripeAccountId      String?
  wompiAccountId       Json?
  subscriptionId       String?
  oneTimeProducts      OneTimeProduct[]
  spots                Spot[]
  extras               Extras[]
  categories           Category[]
  siteName             String?
  aboutUs              String?
  logo                 String?
  favicon              String?
  country              String?
  currency             String?          @default("🇺🇸 USD")
  defaultPaymentMethod String?          @default("cash")
  subdomain            String?          @unique
  customDomain         String?          @unique
}

model Spot {
  id                   String       @id @default(cuid())
  name                 String
  description          String
  status               SpotStatus
  path                 String       @default("")
  units                Int?
  maxGuest             Int?
  duration             Int?
  durationType         String?
  amenities            String[]
  allowAdditionalGuest Boolean      @default(false)
  additionalGuestPrice Float?
  workingHours         Json         @default("[]")
  owner                User         @relation(fields: [userId], references: [id])
  userId               String // Foreign key referencing User's id
  bookings             Booking[]
  images               SpotImages[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime?    @default(now())
  extras               Extras[]
}

model SpotImages {
  id        String   @id @default(cuid())
  url       String
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  spotId    String // Foreign key referencing Spot's id
  createdAt DateTime @default(now())
}

model ExtrasImages {
  id        String   @id @default(cuid())
  url       String
  Extras    Extras   @relation(fields: [extraId], references: [id], onDelete: Cascade)
  extraId   String // Foreign key referencing Extras's id
  createdAt DateTime @default(now())
}

model Booking {
  id            String          @id @default(cuid())
  subtotal      Float
  extras        Float?
  tax           Float?
  totalPrice    Float
  startDate     DateTime?
  endDate       DateTime?
  status        BookingStatus
  guest         Guest?          @relation(fields: [guestId], references: [id])
  guestId       String?
  spot          Spot            @relation(fields: [spotId], references: [id])
  spotId        String // Foreign key referencing Spot's id
  transactions  Transaction[]
  bookingExtras BookingExtras[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @default(now())
  deletedAt     DateTime?
}

model Transaction {
  id          String            @id @default(cuid())
  amount      Float
  paymentDate DateTime
  paymentType String            @default("Cash")
  description String
  status      TransactionStatus @default(Pending)
  allowEdit   Boolean           @default(true)
  booking     Booking           @relation(fields: [bookingId], references: [id])
  bookingId   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime?         @updatedAt
  deletedAt   DateTime?
}

model Extras {
  id            String          @id @default(cuid())
  name          String
  description   String
  price         Float // Add price field for extras
  status        ExtrasStatus
  userId        String // Foreign key referencing User's id
  owner         User            @relation(fields: [userId], references: [id])
  images        ExtrasImages[]
  bookingExtras BookingExtras[]
  spots         Spot[]
  categoryId    String?
  subCategoryId String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory   SubCategory?    @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @default(now())
}

model Guest {
  id       String    @id @default(cuid())
  name     String
  email    String
  phone    String
  dni      String
  address  String?
  note     String    @default("")
  bookings Booking[]
}

model BookingExtras {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  extra     Extras   @relation(fields: [extraId], references: [id])
  extraId   String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model Category {
  id            String        @id @default(cuid())
  name          String
  userId        String // Foreign key referencing User's id
  owner         User          @relation(fields: [userId], references: [id])
  subCategories SubCategory[]
  extras        Extras[]
  createdAt     DateTime      @default(now())
}

model SubCategory {
  id         String   @id @default(cuid())
  name       String
  createdAt  DateTime @default(now())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  extras     Extras[]
}

model OneTimeProduct {
  id              String @id @default(cuid())
  stripeProductId String @unique
  name            String
  users           User[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum BookingStatus {
  In_progress
  Confirmed
  Cancelled
  Waiting_for_payment
}

enum SpotStatus {
  Private
  Public
  Disabled
}

enum TransactionStatus {
  Approved
  Pending
  Declined
  Paid //for testing
  Cancelled //for testing
}

enum ExtrasStatus {
  Private
  Public
  Disabled
}
