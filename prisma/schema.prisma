generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String           @id @default(cuid())
  name                 String?
  email                String?          @unique
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime         @default(now())
  customerId           String?          @unique
  stripeAccountId      String?
  wompiAccountId       Json?
  subscriptionId       String?
  siteName             String?
  aboutUs              String?
  logo                 String?
  favicon              String?
  country              String?
  currency             String?          @default("🇺🇸 USD")
  defaultPaymentMethod String?          @default("cash")
  subdomain            String?          @unique
  customDomain         String?          @unique
  accounts             Account[]
  categories           Category[]
  extras               Extras[]
  sessions             Session[]
  spots                Spot[]
  oneTimeProducts      OneTimeProduct[] @relation("OneTimeProductToUser")
}

model Spot {
  id                   String       @id @default(cuid())
  name                 String
  description          String
  status               SpotStatus
  path                 String       @default("")
  units                Int?
  maxGuest             Int?
  duration             Int?
  durationType         String?
  amenities            String[]
  allowAdditionalGuest Boolean      @default(false)
  additionalGuestPrice Float?
  workingHours         Json         @default("[]")
  userId               String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime?    @default(now())
  bookings             Booking[]
  owner                User         @relation(fields: [userId], references: [id])
  images               SpotImages[]
  extras               Extras[]     @relation("ExtrasToSpot")
}

model SpotImages {
  id        String   @id @default(cuid())
  url       String
  spotId    String
  createdAt DateTime @default(now())
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
}

model ExtrasImages {
  id        String   @id @default(cuid())
  url       String
  extraId   String
  createdAt DateTime @default(now())
  Extras    Extras   @relation(fields: [extraId], references: [id], onDelete: Cascade)
}

model Booking {
  id            String          @id @default(cuid())
  subtotal      Float
  extras        Float?
  tax           Float?
  totalPrice    Float
  startDate     DateTime?
  endDate       DateTime?
  status        BookingStatus
  guestId       String?
  spotId        String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @default(now())
  deletedAt     DateTime?
  guest         Guest?          @relation(fields: [guestId], references: [id])
  spot          Spot            @relation(fields: [spotId], references: [id])
  bookingExtras BookingExtras[]
  transactions  Transaction[]
}

model Transaction {
  id          String            @id @default(cuid())
  amount      Float
  paymentDate DateTime
  paymentType String            @default("Cash")
  description String
  status      TransactionStatus @default(Pending)
  allowEdit   Boolean           @default(true)
  bookingId   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime?         @updatedAt
  deletedAt   DateTime?
  booking     Booking           @relation(fields: [bookingId], references: [id])
}

model Extras {
  id            String          @id @default(cuid())
  name          String
  description   String
  price         Float
  status        ExtrasStatus
  userId        String
  categoryId    String?
  subCategoryId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @default(now())
  bookingExtras BookingExtras[]
  category      Category?       @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory?    @relation(fields: [subCategoryId], references: [id])
  owner         User            @relation(fields: [userId], references: [id])
  images        ExtrasImages[]
  spots         Spot[]          @relation("ExtrasToSpot")
}

model Guest {
  id       String    @id @default(cuid())
  name     String
  email    String
  phone    String
  dni      String
  address  String?
  note     String    @default("")
  bookings Booking[]
}

model BookingExtras {
  id        String    @id @default(cuid())
  bookingId String
  extraId   String
  quantity  Int       @default(1)
  price     Float
  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now())
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  extra     Extras    @relation(fields: [extraId], references: [id])
}

model Category {
  id            String        @id @default(cuid())
  name          String
  userId        String
  createdAt     DateTime      @default(now())
  owner         User          @relation(fields: [userId], references: [id])
  extras        Extras[]
  subCategories SubCategory[]
}

model SubCategory {
  id         String   @id @default(cuid())
  name       String
  createdAt  DateTime @default(now())
  categoryId String
  extras     Extras[]
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model OneTimeProduct {
  id              String @id @default(cuid())
  stripeProductId String @unique
  name            String
  users           User[] @relation("OneTimeProductToUser")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum BookingStatus {
  In_progress
  Confirmed
  Cancelled
  Waiting_for_payment
}

enum SpotStatus {
  Private
  Public
  Disabled
}

enum TransactionStatus {
  Approved
  Pending
  Declined
  Paid
  Cancelled
}

enum ExtrasStatus {
  Private
  Public
  Disabled
}