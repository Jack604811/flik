// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? // @db.Text
  access_token      String? // @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  createdAt       DateTime         @default(now())
  customerId      String?          @unique
  subscriptionId  String?
  oneTimeProducts OneTimeProduct[]
  spots           Spot[]
  guests          Guest[]
  siteName        String?
  logo            String?
  favicon         String?
  subdomain       String?          @unique
  customDomain    String?          @unique
}

model Spot {
  id                   String       @id @default(cuid())
  name                 String
  description          String
  status               SpotStatus
  path                 String     @default("")
  units                Int?
  maxGuest             Int?
  duration             Int?
  durationType         String?
  amenities            String[]
  allowAdditionalGuest Boolean      @default(false)
  additionalGuestPrice Float?
  workingHours         Json         @default("[]")
  owner                User         @relation(fields: [userId], references: [id])
  userId               String // Foreign key referencing User's id
  bookings             Booking[]
  images               SpotImages[]
}

model SpotImages {
  id        String   @id @default(cuid())
  url       String
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  spotId    String // Foreign key referencing Spot's id
  createdAt DateTime @default(now())
}

model Booking {
  id         String        @id @default(cuid())
  subtotal   Float
  extras     Float?
  tax        Float?
  totalPrice Float
  status     BookingStatus
  guest      Guest         @relation(fields: [guestId], references: [id])
  guestId    String
  spot       Spot          @relation(fields: [spotId], references: [id])
  spotId     String // Foreign key referencing Spot's id
  createdAt  DateTime      @default(now())
  deletedAt  DateTime
}

model Guest {
  id       String    @id @default(cuid())
  name     String
  email    String
  phone    String
  address  String?
  owner    User      @relation(fields: [ownerId], references: [id])
  ownerId  String
  bookings Booking[]
}

model OneTimeProduct {
  id              String @id @default(cuid())
  stripeProductId String @unique
  name            String
  users           User[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum BookingStatus {
  Pending
  Confirmed
  Cancelled
}

enum SpotStatus {
  Private
  Public
  Disabled
}
