{
    "rewrites": [
      {
        "source": "/:path*",
        "has": [{ "type": "host", "value": "http://localhost:3001" }],
        "destination": "/src/app/main/(main)/:path*"
      },
      {
        "source": "/:path*",
        "has": [{ "type": "host", "value": "http://localhost:3000" }],
        "destination": "/src/app/main/(public)/:path*"
      }
    ]
  }
  